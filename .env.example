## Backend
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/vaanishopai
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
CORS_ALLOWED_ORIGINS=http://localhost:5847

# Public address of the site (used in WhatsApp/Google link previews and the sitemap).
# Leave empty locally.
APP_PUBLIC_URL=

# Only for docker-compose.yml, which runs its own Postgres.
POSTGRES_PASSWORD=

# JWT
# Generate with: openssl rand -base64 48
# If left empty, a random key is used and everyone is signed out whenever the server restarts.
JWT_SECRET=
JWT_EXPIRATION_MS=604800000

# Groq, used for both chat and speech-to-text.
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Only for reasoning models such as gpt-oss; leave empty for others.
GROQ_REASONING_EFFORT=low
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=en
GROQ_TIMEOUT_MS=30000

# Rate limits
RATE_LIMIT_SPEECH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=8

# Set to "native" when running behind a trusted reverse proxy (nginx, a load balancer)
# so rate limits see real client IPs.
FORWARD_HEADERS_STRATEGY=none

## Frontend
# Only needed when the frontend is hosted separately from the API (see frontend/.env.example).
# VITE_BACKEND_URL=https://api.example.com
